<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="menu.css">
    <title>Payment Counter</title>
</head>
<body>
    <header>
        <nav>
            <img src="logo.png" alt="Logo">
            <a href="/">Customer Entry</a>
            <a href="/kitchen">Kitchen</a>
            <a href="/login">Staff</a>
        </nav>
    </header>

    <main>
        <h1>Payment Counter</h1>
        <div class="cart-actions">
            <form action="/reset-all-tables?_method=PATCH" method="POST">
                <button type="submit" class="danger-button">Free All Tables</button>
            </form>
        </div>
        <section>
            <% if (!orders || orders.length === 0) { %>
                <h2>No bills pending</h2>
            <% } %>
            <% for (let i = 0; i < orders.length; i++) { %>
                <div class="menu-item counter-card">
                    <img src="/bg.webp" alt="Payment order">
                    <h3>Table <span class="table-number"><%= orders[i].tablenum %></span></h3>
                    <p>Order #<span class="order-number"><%= orders[i].order_id %></span></p>
                    <% for (let j = 0; j < orders[i].dishes.length; j++) { %>
                        <p><strong class="quantity-number"><%= orders[i].dishes[j].quantity %>x</strong> <%= orders[i].dishes[j].name %></p>
                    <% } %>
                    <form action="/reset-table?_method=PATCH" method="POST">
                        <input type="hidden" name="order_id" value="<%= orders[i].order_id %>">
                        <button type="submit">Reset Table</button>
                    </form>
                </div>
            <% } %>
        </section>
    </main>

    <footer>
        <div>&copy; 2025 DineFlow. All Rights Reserved.</div>
        <div>Created by- Parth Gupta</div>
    </footer>
</body>
</html>
